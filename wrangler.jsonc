{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radio-lessons",
  "account_id": "df08931372f873bc0c8edb7679dc0cf4",
  "compatibility_date": "2026-10-01",
  // The Worker only answers /api/*; everything else is the static site.
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "radio-lessons", "database_id": "be024778-1d18-4760-ae2b-c5e0ffe002ae", "migrations_dir": "migrations" }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "SITE_URL": "https://radio-lessons.atlesque.dev",
    "MAIL_FROM": "radio-lessons@atlesque.dev"
  },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "radio-lessons.atlesque.dev", "custom_domain": true }]
}
